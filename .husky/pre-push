#!/usr/bin/env sh
# pre-push — public-remote-aware push gate.
#
# Husky v9+ executes this file under `sh`. Arguments are forwarded unchanged
# from git: $1 = remote name, $2 = remote URL.
#
# Two modes, chosen by the remote URL:
#
#   • PUBLIC remote (governancer-foundation/funnel-base-mcp) → full checklist:
#       1. ONE-COMMIT-PER-PUSH gate — at most one new commit may land per push
#          to the public repo. This is the core anti-bump discipline: it keeps
#          the public history a clean, reviewable, one-artifact-per-commit
#          trickle instead of a squashed dump. Bypass ONLY for the documented
#          filter-branch / history-rewrite leak-scrub with
#          GIT_PUSH_LEAK_SCRUB=1.
#       2. oss-ip-guard.sh --dir . — full-tree anti-leak sweep (not just the
#          staged diff: catches anything already committed).
#       3. npm run build — the published artifact (tsc) must compile.
#
#   • any OTHER remote → fast subset: the anti-leak sweep only. The build +
#     one-commit gate are public-repo disciplines; private/canonical pushes
#     skip them for responsiveness.
#
# Both modes block the push on failure.
#
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2026 Agonist Development AB

REMOTE_NAME="${1:-origin}"
REMOTE_URL="${2:-}"

# ── Public-remote detection ─────────────────────────────────────────────────
# Matches the governancer-foundation org on any of the URL shapes git may pass:
#   git@github-...:governancer-foundation/...     (per-account SSH alias)
#   git@github.com:governancer-foundation/...     (plain SSH)
#   https://github.com/governancer-foundation/... (HTTPS)
IS_PUBLIC=0
case "$REMOTE_URL" in
  *:governancer-foundation/*|*github.com:governancer-foundation/*|*github.com/governancer-foundation/*|*github-governancer-foundation:*)
    IS_PUBLIC=1
    ;;
esac

if [ "$IS_PUBLIC" = "1" ]; then
  echo "pre-push: public remote ($REMOTE_URL) — full checklist"

  # ── Gate 1: ONE-COMMIT-PER-PUSH (anti-bump discipline) ────────────────────
  # Each push to the public remote may land at most one new commit. Set
  # GIT_PUSH_LEAK_SCRUB=1 to bypass for the documented filter-branch /
  # history-rewrite leak-scrub exception.
  if [ "${GIT_PUSH_LEAK_SCRUB:-0}" != "1" ]; then
    PENDING=$(git rev-list "@{push}..HEAD" --count 2>/dev/null || echo 0)
    if [ "$PENDING" -gt 1 ]; then
      echo "" >&2
      echo "pre-push BLOCKED — $PENDING commits would land in one push." >&2
      echo "    The public repo enforces one commit per push. Use a" >&2
      echo "    single-commit trickle:" >&2
      echo "      git push $REMOTE_NAME <oldest-unpushed-sha>:refs/heads/<branch>" >&2
      echo "    Or, for a documented history-rewrite leak-scrub:" >&2
      echo "      GIT_PUSH_LEAK_SCRUB=1 git push ..." >&2
      exit 1
    fi
  fi

  # ── Gate 2: full-tree anti-leak sweep ─────────────────────────────────────
  if ! bash scripts/oss-ip-guard.sh --dir .; then
    echo "" >&2
    echo "pre-push BLOCKED — oss-ip-guard found a negative-list match in the" >&2
    echo "  working tree. The public repo must not carry corpus/secret/internal" >&2
    echo "  content. Remove it before pushing." >&2
    exit 1
  fi

  # ── Gate 3: the published artifact must build ─────────────────────────────
  if ! npm run build; then
    echo "" >&2
    echo "pre-push BLOCKED — npm run build (tsc) failed. The published dist/" >&2
    echo "  must compile before pushing to the public repo." >&2
    exit 1
  fi

  echo "pre-push: checklist PASS"
else
  echo "pre-push: $REMOTE_URL — fast checklist (anti-leak sweep only)"
  if ! bash scripts/oss-ip-guard.sh --dir .; then
    echo "" >&2
    echo "pre-push BLOCKED — oss-ip-guard found a negative-list match." >&2
    exit 1
  fi
  echo "pre-push: fast checklist PASS"
fi

exit 0
